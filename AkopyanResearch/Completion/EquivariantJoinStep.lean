module

public import Mathlib.Topology.Algebra.MulAction
public import Mathlib.Topology.Algebra.Group.Basic
public import Mathlib.Topology.Instances.Real.Lemmas

/-!
# An explicit equivariant join step

The join is the quotient of `[0,1] × X × G` which forgets `G` at time zero
and forgets `X` at time one.  Given an equivariant map `F : X → Y` and an
equivariant self-map `phi : Y → Y` with an ordinary nullhomotopy `h`, the
formula `g • h (g⁻¹ • F x, t)` descends to a continuous equivariant map on
this actual quotient.  No existence theorem for `phi` or its nullhomotopy
is asserted.  In particular, no degree or obstruction-theory assumption is
replaced by a new axiom.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace AkopyanResearch.EquivariantJoinStep

abbrev Time := Set.Icc (0 : ℝ) 1

def timeZero : Time := ⟨0, le_rfl, zero_le_one⟩
def timeOne : Time := ⟨1, zero_le_one, le_rfl⟩

abbrev Raw (X G : Type*) := Time × X × G

/-- The generating endpoint identifications for the topological join. -/
def EndpointRel {X G : Type*} (p q : Raw X G) : Prop :=
  (p.1 = timeZero ∧ q.1 = timeZero ∧ p.2.1 = q.2.1) ∨
  (p.1 = timeOne ∧ q.1 = timeOne ∧ p.2.2 = q.2.2)

/-- `Quot` takes the equivalence relation generated by `EndpointRel`;
its topology is the quotient topology. -/
abbrev Join (X G : Type*) := Quot (@EndpointRel X G)

def joinMk {X G : Type*} (t : Time) (x : X) (g : G) : Join X G :=
  Quot.mk _ (t, x, g)

variable {G X Y : Type*}

theorem joinMk_zero (x : X) (g k : G) :
    joinMk timeZero x g = joinMk timeZero x k :=
  Quot.sound (Or.inl ⟨rfl, rfl, rfl⟩)

theorem joinMk_one (x y : X) (g : G) :
    joinMk timeOne x g = joinMk timeOne y g :=
  Quot.sound (Or.inr ⟨rfl, rfl, rfl⟩)

section Action

variable [Group G] [MulAction G X]

def rawAct (a : G) (p : Raw X G) : Raw X G :=
  (p.1, a • p.2.1, a * p.2.2)

theorem rawAct_respects (a : G) (p q : Raw X G) (hpq : EndpointRel p q) :
    EndpointRel (rawAct a p) (rawAct a q) := by
  rcases hpq with ⟨hp, hq, hx⟩ | ⟨hp, hq, hg⟩
  · exact Or.inl ⟨hp, hq, congrArg (a • ·) hx⟩
  · exact Or.inr ⟨hp, hq, congrArg (a * ·) hg⟩

/-- The diagonal action, constructed on the quotient itself. -/
def joinAct (a : G) : Join X G → Join X G :=
  Quot.map (rawAct a) (rawAct_respects a)

@[simp] theorem joinAct_mk (a : G) (t : Time) (x : X) (g : G) :
    joinAct a (joinMk t x g) = joinMk t (a • x) (a * g) := rfl

theorem joinAct_one (z : Join X G) : joinAct (1 : G) z = z := by
  induction z using Quot.inductionOn with
  | h p =>
      rcases p with ⟨t, x, g⟩
      change joinMk t ((1 : G) • x) (1 * g) = joinMk t x g
      simp

theorem joinAct_mul (a b : G) (z : Join X G) :
    joinAct (a * b) z = joinAct a (joinAct b z) := by
  induction z using Quot.inductionOn with
  | h p =>
      rcases p with ⟨t, x, g⟩
      change joinMk t ((a * b) • x) ((a * b) * g) =
        joinMk t (a • b • x) (a * (b * g))
      rw [mul_smul, mul_assoc]

instance : MulAction G (Join X G) where
  smul := joinAct
  one_smul := joinAct_one
  mul_smul := joinAct_mul

@[simp] theorem smul_joinMk (a : G) (t : Time) (x : X) (g : G) :
    a • joinMk t x g = joinMk t (a • x) (a * g) := rfl

variable [TopologicalSpace G] [TopologicalSpace X]
  [IsTopologicalGroup G] [ContinuousSMul G X]

theorem continuous_joinAct (a : G) : Continuous (joinAct (X := X) a) := by
  apply continuous_quot_map
  exact continuous_fst.prodMk
    ((continuous_const.smul continuous_snd.fst).prodMk
      (continuous_const.mul continuous_snd.snd))

end Action

section Construction

variable [Group G] [TopologicalSpace G]
  [TopologicalSpace X] [TopologicalSpace Y]
  [MulAction G X] [MulAction G Y]

/-- All inputs of the join construction.  The homotopy is ordinary; only
its initial self-map and `F` are required to be equivariant. -/
structure ExtensionData (G X Y : Type*) [Group G] [TopologicalSpace G]
    [TopologicalSpace X] [TopologicalSpace Y]
    [MulAction G X] [MulAction G Y] where
  F : X → Y
  phi : Y → Y
  h : Y × Time → Y
  c : Y
  continuous_F : Continuous F
  continuous_phi : Continuous phi
  continuous_h : Continuous h
  equivariant_F : ∀ (a : G) (x : X), F (a • x) = a • F x
  equivariant_phi : ∀ (a : G) (y : Y), phi (a • y) = a • phi y
  start : ∀ y : Y, h (y, timeZero) = phi y
  finish : ∀ y : Y, h (y, timeOne) = c

variable (d : ExtensionData G X Y)

def rawStep (p : Raw X G) : Y :=
  p.2.2 • d.h (p.2.2⁻¹ • d.F p.2.1, p.1)

theorem rawStep_zero (x : X) (g : G) :
    rawStep d (timeZero, x, g) = d.phi (d.F x) := by
  change g • d.h (g⁻¹ • d.F x, timeZero) = _
  rw [d.start, d.equivariant_phi, smul_inv_smul]

theorem rawStep_one (x : X) (g : G) :
    rawStep d (timeOne, x, g) = g • d.c := by
  change g • d.h (g⁻¹ • d.F x, timeOne) = _
  rw [d.finish]

theorem rawStep_respects (p q : Raw X G) (hpq : EndpointRel p q) :
    rawStep d p = rawStep d q := by
  rcases p with ⟨t, x, g⟩
  rcases q with ⟨s, y, k⟩
  rcases hpq with ⟨ht, hs, hxy⟩ | ⟨ht, hs, hgk⟩
  · change t = timeZero at ht
    change s = timeZero at hs
    change x = y at hxy
    subst t
    subst s
    subst y
    rw [rawStep_zero, rawStep_zero]
  · change t = timeOne at ht
    change s = timeOne at hs
    change g = k at hgk
    subst t
    subst s
    subst k
    rw [rawStep_one, rawStep_one]

theorem continuous_rawStep [IsTopologicalGroup G] [ContinuousSMul G Y] :
    Continuous (rawStep d) := by
  exact continuous_snd.snd.smul
    (d.continuous_h.comp
      (((continuous_snd.snd.inv).smul
        (d.continuous_F.comp continuous_snd.fst)).prodMk continuous_fst))

/-- The continuous descended map on the genuine topological join. -/
def step : Join X G → Y := Quot.lift (rawStep d) (rawStep_respects d)

theorem continuous_step [IsTopologicalGroup G] [ContinuousSMul G Y] :
    Continuous (step d) :=
  continuous_quot_lift _ (continuous_rawStep d)

@[simp] theorem step_mk (t : Time) (x : X) (g : G) :
    step d (joinMk t x g) = g • d.h (g⁻¹ • d.F x, t) := rfl

theorem step_zero (x : X) (g : G) :
    step d (joinMk timeZero x g) = d.phi (d.F x) :=
  rawStep_zero d x g

theorem step_one (x : X) (g : G) :
    step d (joinMk timeOne x g) = g • d.c := rawStep_one d x g

theorem rawStep_equivariant (a : G) (p : Raw X G) :
    rawStep d (rawAct a p) = a • rawStep d p := by
  rcases p with ⟨t, x, g⟩
  change (a * g) • d.h ((a * g)⁻¹ • d.F (a • x), t) =
    a • (g • d.h (g⁻¹ • d.F x, t))
  rw [d.equivariant_F]
  simp only [mul_inv_rev, mul_smul, inv_smul_smul]

theorem step_equivariant (a : G) (z : Join X G) :
    step d (a • z) = a • step d z := by
  induction z using Quot.inductionOn with
  | h p => exact rawStep_equivariant d a p

/-- A single join extension, with every endpoint and equivariance property
included in the conclusion. -/
theorem exists_continuous_equivariant_step
    [IsTopologicalGroup G] [ContinuousSMul G Y] :
    ∃ f : Join X G → Y, Continuous f ∧
      (∀ (a : G) (z : Join X G), f (a • z) = a • f z) ∧
      (∀ (x : X) (g : G), f (joinMk timeZero x g) = d.phi (d.F x)) ∧
      (∀ (x : X) (g : G), f (joinMk timeOne x g) = g • d.c) :=
  ⟨step d, continuous_step d, step_equivariant d, step_zero d, step_one d⟩

end Construction

end AkopyanResearch.EquivariantJoinStep
