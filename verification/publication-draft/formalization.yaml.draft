alignment:
  namespace: "AkopyanSixfold"
  statements:
    - source: "Supplied Challenge, theorem A"
      lean: "AkopyanSixfold.tverberg_counterexample"
      module: "Solution"
      status: "proved"
      note: "Almost-six embedding Delta^35 to R^6; exact original statement."
    - source: "Supplied Challenge, theorem B with 36 <= d"
      lean: "AkopyanSixfold.convex_partition_counterexample"
      module: "Solution"
      status: "proved"
      note: "Unconditional dimension bound is d >= 36."
    - source: "Requested strengthening to 17 < d"
      lean: "AkopyanSixfold.convex_partition_counterexample_gt_17_of_relative_lifting"
      module: "AkopyanResearch.Completion.ConcreteReduction"
      status: "proved conditional reduction; target existence still open"
      note: >-
        Explicitly assumes
        AkopyanResearch.ConcreteComparison.RequiredRelativeLifting.
        This is not an unconditional proof of the requested strengthening.

acknowledgements: >-
