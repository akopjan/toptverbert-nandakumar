# NON-SUBMITTABLE DRAFT: new A+B18 publication interface, 2026-11-24 UTC.
# Confirm human authorship, responsible maintenance and the repository licence.
# Replace the pending verification statements only with final release evidence.
# The empty required human fields and licence are deliberate, visible blockers.
# yaml-language-server: $schema=https://raw.githubusercontent.com/mathlib-initiative/formalization.yaml/main/schema/formalization.schema.json
version: "v0.4"

project:
  name: "TopTverberg"
  description: >-
    A Lean 4 development of sixfold Tverberg counterexamples and convex
    six-partition obstructions. The publication interface consists of an
    almost-six embedding of the 35-dimensional simplex into R^6 and an
    unconditional convex six-partition counterexample in every dimension
    d > 17. The latter uses an almost-six embedding of the 89-dimensional
    simplex into R^16, obtained from a concrete comparison of configuration
    spaces, followed by the convex-geometric reduction. The unconditional
    theorem module and the full integrated Lean build, literal statement
    check and declaration-owner axiom audit have passed. The separate
    cumulative source rebuild and independent compiled-interface comparison
    have also passed. The selected final proofs and their dependencies
    were accepted by Lean checker, NanoDa and con-ron, with an additional
    successful replay using the approved newer con-ron. The local
    Comparator attempt was blocked at sandbox setup; registry verification
    is pending.
  authors: [] # REQUIRED: confirmed human formalizers, not models or agents.
  license: "" # REQUIRED: actual SPDX identifier and a matching root licence.
  responsible_maintainers: [] # REQUIRED: confirmed responsible human maintainers.

# This repository contains the substantive development. Therefore omit
# repository.substantive_formalization; that field is only for thin wrappers.
# The public GitHub repository and immutable release commit remain to be set
# in the eventual submission. Do not invent them or a submission authorization.

classification:
  arxiv: ["math.MG", "math.AT"]
  msc2020: ["52C35", "55S91", "52A20"]

